# FastAPI Configuration
DEBUG=true
HOST=0.0.0.0
PORT=8000
SECRET_KEY=your-secret-key-change-this-in-production

# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/ai_coscientist
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=ai_coscientist
POSTGRES_PORT=5432

# Redis Configuration  
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# AI Services Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=4000
OPENAI_TEMPERATURE=0.7

# Vector Database
CHROMA_PERSIST_DIRECTORY=./data/chroma
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# File Storage
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE=10485760

# Research Configuration
MAX_LITERATURE_RESULTS=50
MAX_HYPOTHESIS_COUNT=10
EXPERIMENT_TIMEOUT=300

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# External APIs
ARXIV_API_URL=http://export.arxiv.org/api/query
PUBMED_API_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils
SEMANTIC_SCHOLAR_API_URL=https://api.semanticscholar.org/graph/v1

# CORS Origins (comma-separated)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000 